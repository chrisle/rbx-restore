{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RBXport Restore",
  "mainBinaryName": "rbxport-restore",
  "version": "1.0.0",
  "identifier": "com.rbxport.restore",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RBXport Restore",
        "width": 1040,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Restore RBXport backups",
    "longDescription": "Shows what each RBXport backup of a rekordbox library holds and restores all of it, or only the database, analysis files, artwork or Sync Manager selections.",
    "copyright": "Chris Le",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
